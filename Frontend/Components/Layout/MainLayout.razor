@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only run on the first render and only if we don't already think we're logged in
        if (!firstRender || Auth.IsLoggedIn)
        {
            return;
        }

        // Check browser storage for a saved token 
        var storedToken = await JS.InvokeAsync<string?>("localStorage.getItem", "auth_token")
                           ?? await JS.InvokeAsync<string?>("sessionStorage.getItem", "auth_token");

        if (!string.IsNullOrEmpty(storedToken))
        {
            // If found, restore the session and refresh the UI to show the "Profile" button 
            Auth.TryRestoreToken(storedToken);
            StateHasChanged();
        }
    }

    private async Task HandleLogout()
    {
        Auth.Logout();
        await JS.InvokeVoidAsync("localStorage.removeItem", "auth_token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "email_hint");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "auth_token");
    }
}
