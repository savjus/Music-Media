@inherits LayoutComponentBase
@implements IDisposable
@inject Frontend.Services.AuthService Auth
@inject NavigationManager Nav
@inject ProfileApiService ProfileAPi

@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center gap-2">
            @if (Auth.IsLoggedIn)
            {
                @if (IsProfilePage)
                {
                    @if (ProfileAPi.editing)
                    {
                        <button class="btn btn-outline-primary">
                            Save
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="SwitchEditing">
                            Discard
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-outline-primary" @onclick="SwitchEditing">
                            Edit
                        </button>
                    }
                }
            }
            else
            {
                <NavLink class="btn btn-outline-primary" href="login">
                    Login
                </NavLink>
            }

                <NavLink class="btn btn-outline-secondary" href="profile">
                    Profile
                </NavLink>

                <button class="btn btn-outline-danger" @onclick="HandleLogout">
                    Logout
                </button>

        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
<ReconnectModal/>

@code {
    private bool IsProfilePage => Nav.Uri.EndsWith("/profile");

    protected override void OnInitialized()
    {
        Auth.OnAuthChanged += OnAuthStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        Auth.OnAuthChanged -= OnAuthStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!IsProfilePage && ProfileAPi.editing)
        {
            ProfileAPi.editing = false;
        }
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var storedToken = await JS.InvokeAsync<string?>("localStorage.getItem", "auth_token")
                           ?? await JS.InvokeAsync<string?>("sessionStorage.getItem", "auth_token");

            if (!string.IsNullOrEmpty(storedToken))
            {
                Auth.TryRestoreToken(storedToken);
            }
        }
    }

    private async Task HandleLogout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "auth_token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "email_hint");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "auth_token");
        Nav.NavigateTo("/login");
        Auth.Logout();
    }

    private void SwitchEditing()
    {
        ProfileAPi.editing = !ProfileAPi.editing;
    }
}