@namespace Frontend.Components.Pages.ProfileSections
@using Frontend.Models
@inject Frontend.Services.ProfileApiService ProfileApi

<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Tracks</h5>
        @if (CanEdit)
        {
            <button class="btn btn-outline-primary" @onclick="ToggleTrackEditing">
                @(isEditingTracks ? "Done editing tracks" : "Edit tracks")
            </button>
        }
    </div>

    @if (isEditingTracks)
    {
        <div class="card p-3 mb-3">
            <h5>Add new track</h5>

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control"
                       @bind="newTrackTitle"
                       maxlength="100"
                       placeholder="Enter track title" />
            </div>

            <div class="mb-3">
                <label class="form-label">Album</label>
                <select class="form-select" @bind="selectedAlbumId">
                    <option value="">Select album</option>
                    @foreach (var album in Albums)
                    {
                        <option value="@album.Id">@album.Title</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Genre</label>
                <input class="form-control"
                       @bind="newTrackGenre"
                       maxlength="50"
                       placeholder="Enter track genre" />
            </div>

            <div class="mb-3">
                <label class="form-label">Language</label>
                <input class="form-control"
                       @bind="newTrackLanguage"
                       maxlength="50"
                       placeholder="Enter track language" />
            </div>

            <div class="mb-3">
                <label class="form-label">Length</label>
                <input class="form-control"
                       @bind="newTrackLength"
                       maxlength="5"
                       placeholder="mm:ss" />
            </div>

            <div class="mb-3">
                <label class="form-label">Beats per minute (BPM)</label>
                <input class="form-control"
                       type="number"
                       min="1"
                       max="300"
                       @bind="newTrackBeatsPerMinute"
                       @bind:event="oninput"
                       placeholder="e.g. 120" />
            </div>

            <div class="mb-3">
                <label class="form-label">External link</label>
                <input class="form-control"
                       @bind="newTrackExternalLink"
                       maxlength="300"
                       placeholder="https://example.com" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <button class="btn btn-primary" @onclick="AddTrack">
                Add
            </button>
        </div>
    }

    @if (Tracks.Count == 0)
    {
        <p class="text-muted">No tracks found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Album</th>
                        <th>Genre</th>
                        <th>Language</th>
                        <th>BPM</th>
                        <th>Length</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Tracks)
                    {
                        var albumTitle = t.AlbumId.HasValue
                            ? Albums.FirstOrDefault(a => a.Id == t.AlbumId.Value)?.Title ?? "-"
                            : "-";

                        <tr>
                            <td class="text-break">@t.Title</td>
                            <td class="text-break">@albumTitle</td>
                            <td class="text-break">@t.Genre</td>
                            <td class="text-break">@t.Language</td>
                            <td>@(t.BeatsPerMinute?.ToString() ?? "-")</td>
                            <td>@(t.Length?.ToString(@"mm\:ss") ?? "-")</td>
                            <td class="text-break">
                                @if (!string.IsNullOrWhiteSpace(t.ExternalLink))
                                {
                                    <a href="@t.ExternalLink" target="_blank">Open</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public List<TrackDto> Tracks { get; set; } = new();
    [Parameter] public List<AlbumDto> Albums { get; set; } = new();
    [Parameter] public bool CanEdit { get; set; } = true;

    private bool isEditingTracks = false;
    private string newTrackTitle = string.Empty;
    private int? selectedAlbumId;
    private string newTrackGenre = string.Empty;
    private string newTrackLanguage = string.Empty;
    private string newTrackLength = string.Empty;
    private int? newTrackBeatsPerMinute;
    private string newTrackExternalLink = string.Empty;
    private string errorMessage = string.Empty;

    private void ToggleTrackEditing()
    {
        isEditingTracks = !isEditingTracks;
        errorMessage = string.Empty;
    }

    private async Task AddTrack()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(newTrackTitle))
        {
            errorMessage = "Title is required.";
            return;
        }

        TimeSpan? parsedLength = null;

        if (!string.IsNullOrWhiteSpace(newTrackLength))
        {
            if (newTrackLength.Length != 5 || newTrackLength[2] != ':')
            {
                errorMessage = "Length must use mm:ss format.";
                return;
            }

            if (!TimeSpan.TryParse("00:" + newTrackLength, out var time))
            {
                errorMessage = "Length must use mm:ss format.";
                return;
            }

            parsedLength = time;
        }

        if (!string.IsNullOrWhiteSpace(newTrackExternalLink)
            && !Uri.TryCreate(newTrackExternalLink, UriKind.Absolute, out _))
        {
            errorMessage = "External link must be a valid URL.";
            return;
        }

        if (newTrackBeatsPerMinute.HasValue && (newTrackBeatsPerMinute < 1 || newTrackBeatsPerMinute > 300))
        {
            errorMessage = "BPM must be between 1 and 300.";
            return;
        }

        var newTrack = new TrackDto
        {
            Title = newTrackTitle.Trim(),
            AlbumId = selectedAlbumId,
            Genre = newTrackGenre.Trim(),
            Language = newTrackLanguage.Trim(),
            BeatsPerMinute = newTrackBeatsPerMinute,
            Length = parsedLength,
            ExternalLink = newTrackExternalLink.Trim()
        };

        var savedTrack = await ProfileApi.AddTrackAsync(newTrack);

        if (savedTrack is null)
        {
            errorMessage = "Failed to save track.";
            return;
        }

        Tracks.Add(savedTrack);

        newTrackTitle = string.Empty;
        selectedAlbumId = null;
        newTrackGenre = string.Empty;
        newTrackLanguage = string.Empty;
        newTrackLength = string.Empty;
        newTrackBeatsPerMinute = null;
        newTrackExternalLink = string.Empty;
    }
}