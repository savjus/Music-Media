@page "/login"

<h3>Log In</h3>

<div class="card p-4 mt-3" style="max-width:400px">

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email"
               class="form-control"
               placeholder="Enter your email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password"
               class="form-control"
               placeholder="Enter your password" />
    </div>

</div>