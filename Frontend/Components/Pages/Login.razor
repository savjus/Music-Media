@page "/login"
@rendermode InteractiveServer
@inject Frontend.Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Enter your information to continue</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-2" style="max-width:400px">@errorMessage</div>
}

<div class="card p-4 mt-3" style="max-width:400px">

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email"
               class="form-control"
               placeholder="Enter your email"
               @bind="email" />
    </div>

    <div class="input-group mb-3">
        <input type="@PasswordInputType"
               class="form-control"
               placeholder="Enter your password"
               @bind="password" />

        <button class="btn btn-outline-secondary" type="button" @onclick="TogglePassword">
            👁
        </button>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="rememberMe" @bind="rememberMe" />
        <label class="form-check-label" for="rememberMe">Remember me</label>
    </div>

    <button class="btn btn-primary w-100 mb-2" @onclick="HandleLogin">
        Continue
    </button>

    <p class="text-muted small">
        Don't have an account?
        <NavLink href="/register">Register</NavLink>
    </p>

    <p class="text-muted small">
        Forgot your password?
        <NavLink href="/forgot-password">Reset it here</NavLink>
    </p>

</div>

@code {
    private string email = "";
    private string password = "";
    private bool rememberMe = false;
    private bool showPassword = false;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/profile");
            return;
        }

        var storedToken = await JS.InvokeAsync<string?>("localStorage.getItem", "auth_token")
                       ?? await JS.InvokeAsync<string?>("sessionStorage.getItem", "auth_token");
        if (!string.IsNullOrEmpty(storedToken) && Auth.TryRestoreToken(storedToken))
        {
            Nav.NavigateTo("/profile");
            return;
        }

        var hint = await JS.InvokeAsync<string?>("localStorage.getItem", "email_hint");
        if (!string.IsNullOrEmpty(hint))
        {
            email = hint;
            StateHasChanged();
        }
    }

    private string PasswordInputType => showPassword ? "text" : "password";

    private void TogglePassword() 
    {
        showPassword = !showPassword;
    } 

    private async Task HandleLogin()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please fill in all fields.";
            return;
        }

        if (await Auth.LoginAsync(email, password, rememberMe))
        {
            if (rememberMe && Auth.Token != null)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "auth_token", Auth.Token);
                await JS.InvokeVoidAsync("localStorage.setItem", "email_hint", email);
                await JS.InvokeVoidAsync("sessionStorage.removeItem", "auth_token");
            }
            else
            {
                await JS.InvokeVoidAsync("sessionStorage.setItem", "auth_token", Auth.Token);
                await JS.InvokeVoidAsync("localStorage.removeItem", "auth_token");
                await JS.InvokeVoidAsync("localStorage.removeItem", "email_hint");
            }
            Nav.NavigateTo("/profile");
        }
        else
        {
            errorMessage = "Invalid email or password.";
        }
    }
}