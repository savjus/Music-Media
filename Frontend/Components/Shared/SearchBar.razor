@* Search bar UI: text input with optional autocomplete suggestions, clear button, optional Search button. *@
<div class="search-bar-row mb-3">
    <div class="search-bar-input-wrapper position-relative flex-grow-1" style="min-width: 200px;">
        <input class="form-control pe-4"
               type="text"
               placeholder="@Placeholder"
               value="@Value"
               @oninput="OnInput"
               @onkeydown="OnKeyDown"
               autocomplete="off" />
        
        @if (ShowClearButton && !string.IsNullOrWhiteSpace(Value))
        {
            <button type="button"
                    class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted text-decoration-none p-0 me-2"
                    style="font-size: 1.25rem; line-height: 1;"
                    @onclick="ClearAndSearch"
                    aria-label="Clear search">
                ×
            </button>
        }

        @if (ShowAutoComplete && Suggestions != null && Suggestions.Count > 0 && !string.IsNullOrEmpty(Value))
        {
            <div class="dropdown-menu show w-100" style="display: block; position: absolute; top: 100%; left: 0; z-index: 1000; max-height: 300px; overflow-y: auto;">
                @foreach (var suggestion in Suggestions.Take(5))
                {
                    var capturedSuggestion = suggestion;
                    <button type="button"
                            class="dropdown-item"
                            @onclick="() => SelectSuggestion(capturedSuggestion)">
                        @suggestion
                    </button>
                }
            </div>
        }
    </div>

    @if (ShowSearchButton)
    {
        <button class="btn btn-primary" @onclick="InvokeSearch">Search</button>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search…";
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback<string> OnInputChanged { get; set; }
    [Parameter] public bool ShowClearButton { get; set; } = true;
    [Parameter] public bool ShowSearchButton { get; set; } = true;
    [Parameter] public bool ShowAutoComplete { get; set; } = false;
    [Parameter] public List<string> Suggestions { get; set; } = [];

    private async Task OnInput(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(v);
        await OnInputChanged.InvokeAsync(v);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await InvokeSearch();
    }

    private async Task ClearAndSearch()
    {
        await ValueChanged.InvokeAsync("");
        await OnInputChanged.InvokeAsync("");
        await InvokeSearch();
    }

    private async Task InvokeSearch()
    {
        await OnSearch.InvokeAsync();
    }

    private async Task SelectSuggestion(string suggestion)
    {
        await ValueChanged.InvokeAsync(suggestion);
        await OnInputChanged.InvokeAsync(suggestion);
        await InvokeSearch();
    }
}
